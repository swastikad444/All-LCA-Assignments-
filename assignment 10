#include <stdio.h>

int main()
{
    int year, m, d, i, start;
    int days[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    char *name[12] = {"January", "February", "March", "April", "May", "June",
                      "July", "August", "September", "October", "November", "December"};

    printf("Enter year: ");
    scanf("%d", &year);

    /* leap year check */
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0))
        days[1] = 29;

    /* day of 1 January: 0=Sun, 1=Mon, ... 6=Sat */
    start = (1 + 5 * ((year - 1) % 4) + 4 * ((year - 1) % 100) + 6 * ((year - 1) % 400)) % 7;

    for (m = 0; m < 12; m++)
    {
        printf("\n---------- %s %d ----------\n", name[m], year);
        printf("  Sun Mon Tue Wed Thu Fri Sat\n");

        /* spaces before the 1st day */
        for (i = 0; i < start; i++)
            printf("    ");

        for (d = 1; d <= days[m]; d++)
        {
            printf("%4d", d);
            if ((start + d) % 7 == 0)
                printf("\n");
        }
        printf("\n");

        /* first day of next month */
        start = (start + days[m]) % 7;
    }

    return 0;
}
