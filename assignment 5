#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char s1[50], s2[50];
    int choice, i, len;

    printf("Enter first string: ");
    scanf("%s", s1);
    printf("Enter second string: ");
    scanf("%s", s2);

    do
    {
        printf("\n----- MENU -----\n");
        printf("1. Length\n");
        printf("2. Copy\n");
        printf("3. Concatenate\n");
        printf("4. Compare\n");
        printf("5. Reverse\n");
        printf("6. Uppercase\n");
        printf("7. Lowercase\n");
        printf("8. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Length of first string = %d\n", strlen(s1));
                break;

            case 2:
                strcpy(s2, s1);
                printf("After copy, second string = %s\n", s2);
                break;

            case 3:
                strcat(s1, s2);
                printf("After concatenation, first string = %s\n", s1);
                break;

            case 4:
                if (strcmp(s1, s2) == 0)
                    printf("Both strings are equal\n");
                else
                    printf("Strings are not equal\n");
                break;

            case 5:
                len = strlen(s1);
                printf("Reverse = ");
                for (i = len - 1; i >= 0; i--)
                    printf("%c", s1[i]);
                printf("\n");
                break;

            case 6:
                for (i = 0; s1[i] != '\0'; i++)
                    s1[i] = toupper(s1[i]);
                printf("Uppercase = %s\n", s1);
                break;

            case 7:
                for (i = 0; s1[i] != '\0'; i++)
                    s1[i] = tolower(s1[i]);
                printf("Lowercase = %s\n", s1);
                break;

            case 8:
                printf("Thank you\n");
                break;

            default:
                printf("Invalid choice\n");
        }
    } while (choice != 8);

    return 0;
}
